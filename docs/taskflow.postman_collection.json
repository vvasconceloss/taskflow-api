{
  "info": {
    "name": "TaskFlow API",
    "description": "Task management API for teams — workspaces, projects and tasks with role-based access. Login first, then use the returned token in the Authorization header (the collection uses the {{token}} variable).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPass123\",\n  \"name\": \"Victor\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPass123\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Workspaces",
      "item": [
        {
          "name": "List my workspaces",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/workspaces?page=1&pageSize=20&sortBy=name&sortDir=asc",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "sortBy", "value": "name" },
                { "key": "sortDir", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Create workspace",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/workspaces",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Acme\"\n}" }
          }
        },
        {
          "name": "Get workspace",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/workspaces/:workspaceId"
          }
        },
        {
          "name": "Update workspace (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/workspaces/:workspaceId",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Acme 2\"\n}" }
          }
        },
        {
          "name": "Delete workspace (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/workspaces/:workspaceId"
          }
        },
        {
          "name": "Add member (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/workspaces/:workspaceId/members",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"member@example.com\"\n}" }
          }
        },
        {
          "name": "Change member role (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/workspaces/:workspaceId/members/:userId",
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"Admin\"\n}" }
          }
        },
        {
          "name": "Remove member (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/workspaces/:workspaceId/members/:userId"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/workspaces/:workspaceId/projects?sortBy=name&sortDir=asc",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", ":workspaceId", "projects"],
              "query": [
                { "key": "sortBy", "value": "name" },
                { "key": "sortDir", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/workspaces/:workspaceId/projects",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Platform\"\n}" }
          }
        },
        {
          "name": "Get project",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/projects/:projectId"
          }
        },
        {
          "name": "Update project",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/projects/:projectId",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Platform v2\",\n  \"description\": \"Renamed\"\n}" }
          }
        },
        {
          "name": "Archive project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/projects/:projectId/archive"
          }
        },
        {
          "name": "Delete project",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/projects/:projectId"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List tasks (filtered)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/projects/:projectId/tasks?status=Done&priority=High&sortBy=dueDate&sortDir=asc",
              "host": ["{{baseUrl}}"],
              "path": ["projects", ":projectId", "tasks"],
              "query": [
                { "key": "status", "value": "Done" },
                { "key": "priority", "value": "High" },
                { "key": "sortBy", "value": "dueDate" },
                { "key": "sortDir", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/projects/:projectId/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Set up CI\",\n  \"description\": \"GitHub Actions with build + test\",\n  \"priority\": \"High\"\n}"
            }
          }
        },
        {
          "name": "Get task",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/tasks/:taskId"
          }
        },
        {
          "name": "Update task",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/tasks/:taskId",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Set up CI on main\",\n  \"priority\": \"Medium\"\n}"
            }
          }
        },
        {
          "name": "Change status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/tasks/:taskId/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Done\"\n}" }
          }
        },
        {
          "name": "Assign task",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/tasks/:taskId/assignee",
            "body": { "mode": "raw", "raw": "{\n  \"assigneeUserId\": \"00000000-0000-0000-0000-000000000000\"\n}" }
          }
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/tasks/:taskId"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5183" },
    { "key": "token", "value": "" }
  ]
}
